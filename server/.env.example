# ─────────────────────────────────────────────────────────────────────────────
# CarePath AI — Backend Environment Variables (EXAMPLE)
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER put real secrets in this file — it is committed to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string or local MongoDB URI
MONGODB_URI=mongodb+srv://239x1a3335_db_user:SNXffi9GXbTDf5zF@cluster0.xaslgvx.mongodb.net/CarePath-AI?retryWrites=true&w=majority&appName=Cluster0
# ── Authentication ────────────────────────────────────────────────────────────
# Long random secret (generate with: openssl rand -hex 64)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ── Google Gemini AI ──────────────────────────────────────────────────────────

GEMINI_API_KEY=

# Gemini model selection
GEMINI_MODEL=gemini-3.6-flash

# ── CORS ──────────────────────────────────────────────────────────────────────
# Frontend URL (Vite dev: http://localhost:5173, or your Netlify URL)
CLIENT_URL=http://localhost:5173
